{
  "expo": {
    "name": "StarDev",
    "slug": "stardev-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stardev",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2e8e0"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "br.com.stardev.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#814456"
      },
      "permissions": ["INTERNET", "READ_EXTERNAL_STORAGE"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.stardev.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O StarDev usa a galeria para você escolher sua foto de perfil."
        }
      ]
    ]
  }
}
